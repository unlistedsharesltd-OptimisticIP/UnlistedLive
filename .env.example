# Copy to .env.local (local dev) and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for sitemap, canonical URLs and the exhibition QR code)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase (Project Settings → API). The anon / publishable key is safe to expose;
# all writes are protected by Row Level Security (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Lead email alerts (https://resend.com). If RESEND_API_KEY is empty, leads are
# still saved but no email is sent (a warning is logged).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Optimistic IP <leads@your-verified-domain.com>
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Floating WhatsApp button (number in international format, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi Optimistic IP, I'd like to know more about unlisted shares.

# Analytics (both optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false
